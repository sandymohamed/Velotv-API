    "device:provision": "node --env-file-if-exists=.env scripts/provision-device.js",
    "account:create": "node --env-file-if-exists=.env scripts/create-account.js",
    "dev": "nodemon --watch src --watch .env --ext js,json,env --exec \"node --env-file-if-exists=.env\" src/server.js"
  },
