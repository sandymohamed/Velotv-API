PORT=3000
DATABASE_URL=mysql://USERNAME:ENCODED_PASSWORD@HOST:PORT/velotv
DB_CA_FILE=./ca.pem
DB_AUTO_CREATE=true
DB_AUTO_MIGRATE=true
JWT_SECRET=
# For a local development DB without TLS only:
# DB_SSL=disable

# Optional PayPal reseller package checkout and balance top-up.
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MERCHANT_ID=
# PUBLIC_API_URL=https://api.example.com
# PAYPAL_SUCCESS_URL=https://dashboard.example.com/success
# PAYPAL_CANCEL_URL=https://dashboard.example.com/cancelled

# Google Play subscription verification (server only).
# GOOGLE_PLAY_PACKAGE_NAME=com.velotv.player
# GOOGLE_PLAY_PRODUCT_ID=
# GOOGLE_PLAY_BASE_PLAN_ID=
# GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/absolute/private/path/play-service-account.json

# Comma-separated origins, without trailing slash
DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3001,http://127.0.0.1:3001
# Add http://localhost:5174 (and the published admin origin) to DASHBOARD_ORIGINS
